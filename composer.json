{
    "name": "rajibul-16103404/omnicast-laravel-sdk",
    "description": "A production-ready Laravel SDK for interacting with the OmniCast WebRTC live streaming media server.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Rajibul-16103404/laravel-sdk",
    "keywords": [
        "laravel",
        "webrtc",
        "omnicast",
        "live-streaming",
        "media-server",
        "streaming",
        "realtime",
        "sfu",
        "jwt",
        "turn",
        "stun",
        "webhooks",
        "sdk"
    ],
    "authors": [
        {
            "name": "Rajibul Islam",
            "role": "Developer"
        },
        {
            "name": "OmniCast",
            "email": "dev@omnicast.io",
            "homepage": "https://omnicast.live",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Rajibul-16103404/laravel-sdk/issues",
        "source": "https://github.com/Rajibul-16103404/laravel-sdk"
    },
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^7.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnicast\\LaravelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnicast\\LaravelSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omnicast\\LaravelSdk\\OmnicastServiceProvider"
            ],
            "aliases": {
                "Omnicast": "Omnicast\\LaravelSdk\\Facades\\Omnicast"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
