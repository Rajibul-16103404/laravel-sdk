{
    "name": "omnicast/laravel-sdk",
    "description": "A production-ready Laravel SDK for interacting with the OmniCast WebRTC media server.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "webrtc",
        "omnicast",
        "media-server",
        "sdk",
        "jwt",
        "streaming"
    ],
    "authors": [
        {
            "name": "OmniCast",
            "email": "dev@omnicast.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Omnicast\\LaravelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnicast\\LaravelSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omnicast\\LaravelSdk\\OmnicastServiceProvider"
            ],
            "aliases": {
                "Omnicast": "Omnicast\\LaravelSdk\\Facades\\Omnicast"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
